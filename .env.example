# PostgreSQL connection string (local PostgreSQL or Supabase).
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/explore_india
# For Supabase or another hosted PostgreSQL provider, paste its connection string here.
# Set PGSSL=true for hosted PostgreSQL providers that require SSL (such as Supabase).
PGSSL=true

# Use a long, private value for sessions.
SESSION_SECRET= 

# First admin account. It is created the first time you run npm run init-db.
ADMIN_USERNAME=
ADMIN_PASSWORD=

PORT=3000
